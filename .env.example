# =====================================================================
# Lebane - variables de entorno de ejemplo.
# Copiar a .env y reemplazar TODOS los valores "change-me".
# Nunca commitear .env (está en .gitignore).
# =====================================================================

# ---------- Proyecto ----------
COMPOSE_PROJECT_NAME=lebane

# ---------- PostgreSQL ----------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=lebane
POSTGRES_USER=lebane
POSTGRES_PASSWORD=change-me-db-password
# Puerto publicado en el host (solo para desarrollo/herramientas locales)
POSTGRES_HOST_PORT=5432

# ---------- Backend: base de datos ----------
DB_URL=jdbc:postgresql://postgres:5432/lebane
DB_USERNAME=lebane
DB_PASSWORD=change-me-db-password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=3000

# ---------- MinIO ----------
# MinIO dejó de publicar imágenes "community" nuevas a fines de 2025: se fija un release concreto.
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------- Backend: storage (se usa a partir de la Fase 4) ----------
STORAGE_ENDPOINT=http://minio:9000
# URL pública con la que el navegador accede a los objetos
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_ACCESS_KEY=change-me-minio-user
STORAGE_SECRET_KEY=change-me-minio-password
STORAGE_BUCKET=lebane-images
STORAGE_REGION=us-east-1

# ---------- Backend: servidor ----------
BACKEND_HOST_PORT=8080
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
FORWARD_HEADERS_STRATEGY=none
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# ---------- Backend: CORS ----------
# Lista separada por comas. En Docker el frontend usa el proxy de nginx (mismo origen).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Backend: Actuator ----------
# /actuator/health* e /actuator/info son públicos.
# /actuator/metrics y /actuator/prometheus requieren HTTP Basic con estas credenciales.
ACTUATOR_USERNAME=actuator
ACTUATOR_PASSWORD=change-me-actuator-password
TRACING_SAMPLING_PROBABILITY=0.1

# ---------- Backend: logging ----------
LOG_LEVEL=INFO
LOG_LEVEL_APP=INFO
# json (producción/Docker) | text (desarrollo local legible)
LOG_FORMAT=json
LOG_SERVICE_NAME=lebane-backend
LOG_ENVIRONMENT=local
LOGSTASH_ENABLED=false
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000

# ---------- Proveedor de direcciones (Fase 4) ----------
ADDRESS_PROVIDER=stub
ADDRESS_PROVIDER_URL=
ADDRESS_PROVIDER_API_KEY=
ADDRESS_PROVIDER_TIMEOUT_MS=2000
ADDRESS_PROVIDER_MAX_RESULTS=5

# ---------- Frontend ----------
FRONTEND_HOST_PORT=3000
# Base de la API vista por el navegador. "/api" usa el proxy de nginx/Vite.
VITE_API_BASE_URL=/api
# Upstream que nginx usa para /api y /actuator/health (red interna de Docker)
BACKEND_UPSTREAM=http://backend:8080

# ---------- Observabilidad (perfil "observability") ----------
ELASTIC_VERSION=8.19.4
ELASTIC_PASSWORD=change-me-elastic-password
KIBANA_SYSTEM_PASSWORD=change-me-kibana-password
# Clave de cifrado de Kibana: mínimo 32 caracteres
KIBANA_ENCRYPTION_KEY=change-me-with-at-least-32-characters-0000
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms256m -Xmx256m
ELASTICSEARCH_HOST_PORT=9200
KIBANA_HOST_PORT=5601
LOGSTASH_TCP_HOST_PORT=5000
