# Plantilla procesada con envsubst por la imagen oficial de nginx (solo variables definidas, p. ej. BACKEND_UPSTREAM).

# Propaga el X-Request-Id del navegador; si no viene, usa el id interno de nginx.
map $http_x_request_id $lebane_request_id {
    default $http_x_request_id;
    ""      $request_id;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size 30m;

    # El upstream va en una variable para que nginx lo resuelva por DNS en cada request (cacheado `valid`
    # segundos). Con un nombre fijo en proxy_pass, nginx resuelve la IP una sola vez al arrancar y responde 502
    # cuando el contenedor del backend se reinicia con otra IP. NGINX_RESOLVER: DNS embebido de Docker por defecto.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 3s;
    set $backend_upstream ${BACKEND_UPSTREAM};

    # Headers de seguridad: SOLO a nivel server. nginx no hereda los add_header de este nivel en un location que
    # declara los suyos, así que ningún location usa add_header (el cache se configura con `expires`).
    # CSP: sin scripts ni estilos inline (el build de Vite no los genera); imágenes del propio origen, blob: (vistas
    # previas antes de subir) y el origen público de MinIO (IMAGES_ORIGIN = STORAGE_PUBLIC_URL).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data: ${IMAGES_ORIGIN}; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # API REST -> backend (mismo origen para el navegador: no requiere CORS)
    location /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $lebane_request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # El backend ya envía estos headers; nginx agrega los suyos (nivel server): se ocultan para no duplicarlos.
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-XSS-Protection;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Solo se exponen los health checks públicos; metrics/prometheus no pasan por el frontend.
    location ~ ^/actuator/health(/liveness|/readiness)?$ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $lebane_request_id;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-XSS-Protection;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    location /actuator/ {
        return 404;
    }

    # Nombres con hash de contenido: se pueden cachear un año.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # SPA: cualquier otra ruta devuelve index.html
    location / {
        # index.html se revalida siempre (Cache-Control: no-cache): así toma los assets de cada despliegue.
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
