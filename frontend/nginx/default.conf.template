# Plantilla procesada con envsubst por la imagen oficial de nginx (solo variables definidas, p. ej. BACKEND_UPSTREAM).

# Propaga el X-Request-Id del navegador; si no viene, usa el id interno de nginx.
map $http_x_request_id $lebane_request_id {
    default $http_x_request_id;
    ""      $request_id;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size 30m;

    # El upstream va en una variable para que nginx lo resuelva por DNS en cada request (cacheado `valid`
    # segundos). Con un nombre fijo en proxy_pass, nginx resuelve la IP una sola vez al arrancar y responde 502
    # cuando el contenedor del backend se reinicia con otra IP. NGINX_RESOLVER: DNS embebido de Docker por defecto.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 3s;
    set $backend_upstream ${BACKEND_UPSTREAM};

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # API REST -> backend (mismo origen para el navegador: no requiere CORS)
    location /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $lebane_request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Solo se exponen los health checks públicos; metrics/prometheus no pasan por el frontend.
    location ~ ^/actuator/health(/liveness|/readiness)?$ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $lebane_request_id;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    location /actuator/ {
        return 404;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # SPA: cualquier otra ruta devuelve index.html
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri $uri/ /index.html;
    }
}
