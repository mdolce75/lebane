<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de logging de Lebane.

  - LOG_FORMAT=json  (default): JSON estructurado a stdout (logback-format-json.xml).
  - LOG_FORMAT=text           : texto legible para desarrollo local (logback-format-text.xml).
  - LOGSTASH_ENABLED=true     : además envía JSON a Logstash por TCP, asíncrono y no bloqueante (logback-logstash-true.xml).

  Los valores se leen del Environment de Spring (application.yml -> variables de entorno).
-->
<configuration scan="false">
    <!-- Reemplaza el listener de consola que registra Spring Boot (texto plano + stack trace) por eventos JSON,
         limitados a uno por origen por minuto: una caída de Logstash no inunda stdout ni rompe el formato. -->
    <statusListener class="com.lebane.logging.StructuredStatusListener"/>

    <springProperty scope="context" name="LOG_FORMAT" source="lebane.logging.format" defaultValue="json"/>
    <springProperty scope="context" name="LOG_SERVICE_NAME" source="lebane.logging.service-name" defaultValue="lebane-backend"/>
    <springProperty scope="context" name="LOG_APPLICATION" source="spring.application.name" defaultValue="lebane-backend"/>
    <springProperty scope="context" name="LOG_ENVIRONMENT" source="lebane.logging.environment" defaultValue="local"/>
    <springProperty scope="context" name="LOGSTASH_ENABLED" source="lebane.logging.logstash.enabled" defaultValue="false"/>
    <springProperty scope="context" name="LOGSTASH_HOST" source="lebane.logging.logstash.host" defaultValue="logstash"/>
    <springProperty scope="context" name="LOGSTASH_PORT" source="lebane.logging.logstash.port" defaultValue="5000"/>

    <!-- Campos comunes a todos los eventos JSON -->
    <property name="LOG_CUSTOM_FIELDS"
              value="{&quot;service&quot;:&quot;${LOG_SERVICE_NAME}&quot;,&quot;application&quot;:&quot;${LOG_APPLICATION}&quot;,&quot;environment&quot;:&quot;${LOG_ENVIRONMENT}&quot;}"/>

    <!--
      Sin <if>: en Logback 1.5.x el atributo "condition" está deprecado y Spring Boot imprime ese warning en stdout
      como texto plano (rompe el stream JSON); el reemplazo <condition> no ejecuta ninguna rama en 1.5.20.
      La selección se hace con includes parametrizados:
      - Formato (obligatorio): logback-format-json.xml | logback-format-text.xml. LOG_FORMAT se valida al arrancar
        (LoggingProperties): un valor inválido detiene la aplicación en lugar de dejarla sin logs.
      - Logstash (opcional): solo existe logback-logstash-true.xml; con cualquier otro valor no se incluye nada,
        no se crea el appender TCP y no hay intentos de conexión.
    -->
    <include resource="logback-format-${LOG_FORMAT}.xml"/>
    <include optional="true" resource="logback-logstash-${LOGSTASH_ENABLED}.xml"/>

    <!-- Estados internos de Logback (StructuredStatusListener): solo a stdout, nunca a Logstash (evita bucles). -->
    <logger name="com.lebane.logging.logback" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Los appenders se asocian a root dentro de cada archivo incluido. Nivel efectivo: logging.level.root -->
    <root level="INFO"/>
</configuration>
