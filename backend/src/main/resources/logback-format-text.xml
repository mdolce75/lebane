<?xml version="1.0" encoding="UTF-8"?>
<!--
  Texto legible para desarrollo local (LOG_FORMAT=text). Incluye requestId y traceId del MDC.
  Los argumentos estructurados (kv) se renderizan como "clave=valor" en el mensaje.
-->
<included>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %highlight(%-5level) [%thread] [req=%X{requestId:--} trace=%X{traceId:--}] %cyan(%logger{36}) - %msg%n%throwable</pattern>
        </encoder>
    </appender>

    <root>
        <appender-ref ref="CONSOLE"/>
    </root>
</included>
