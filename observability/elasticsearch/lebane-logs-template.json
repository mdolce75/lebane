{
  "index_patterns": ["lebane-logs-*"],
  "priority": 200,
  "_meta": {
    "description": "Logs JSON del backend de Lebane (Logstash -> lebane-logs-YYYY.MM.dd). Campos: README, seccion Observabilidad."
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "lebane-logs",
      "index.mapping.total_fields.limit": 300,
      "index.mapping.ignore_malformed": true
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "@version": { "type": "keyword" },
        "message": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
        "exception": { "type": "text" },
        "level": { "type": "keyword" },
        "logger": { "type": "keyword" },
        "thread": { "type": "keyword" },
        "service": { "type": "keyword" },
        "application": { "type": "keyword" },
        "environment": { "type": "keyword" },
        "requestId": { "type": "keyword" },
        "traceId": { "type": "keyword" },
        "spanId": { "type": "keyword" },
        "method": { "type": "keyword" },
        "path": { "type": "keyword" },
        "status": { "type": "integer" },
        "durationMs": { "type": "long" },
        "responseSize": { "type": "long" },
        "remoteAddress": { "type": "keyword" },
        "errorCode": { "type": "keyword" },
        "circuitBreaker": { "type": "keyword" },
        "provider": { "type": "keyword" },
        "fromState": { "type": "keyword" },
        "toState": { "type": "keyword" },
        "state": { "type": "keyword" },
        "attempts": { "type": "integer" },
        "waitMs": { "type": "long" },
        "timeoutMs": { "type": "long" },
        "cause": { "type": "keyword" },
        "fallback": { "type": "boolean" },
        "operation": { "type": "keyword" },
        "outcome": { "type": "keyword" },
        "bucket": { "type": "keyword" },
        "objectKey": { "type": "keyword" },
        "sizeBytes": { "type": "long" },
        "contentType": { "type": "keyword" },
        "compensation": { "type": "boolean" },
        "departamentoId": { "type": "long" },
        "imagenId": { "type": "long" },
        "consultaId": { "type": "long" },
        "logbackOrigin": { "type": "keyword" }
      }
    }
  }
}
